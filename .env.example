# ─────────────────────────────────────────────────────────────
# SnapSpot environment variables
# Copy this file to `.env.local` and fill in your values.
# NEVER commit .env.local — it is git-ignored.
# ─────────────────────────────────────────────────────────────

# ── Firebase (required) ──────────────────────────────────────
# From Firebase Console → Project settings → General → Your apps (Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ── Cloudinary (required) ────────────────────────────────────
# From Cloudinary Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-api-key
# Secret — NEVER expose this in the browser (server-only)
CLOUDINARY_API_SECRET=your-api-secret
# The unsigned upload preset must also exist in your Cloudinary account:
#   Settings → Upload → Add upload preset → Signing mode: Unsigned
#   (name it "snapspot_uploads" or update lib/cloudinaryService.ts)

# ── Hugging Face (optional, enables moderation + object labels) ──
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Google Cloud Vision (optional, stronger moderation) ──────
# Get a key at https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=
