rules_version = '2';

// SnapSpot Firestore Security Rules
//
// Model:
//  - Events and photos are PUBLICLY readable (guests join via QR code, no login)
//  - Any guest (even anonymous) can ADD a photo to an event
//  - Only the signed-in organizer who owns the event can edit/delete events & photos
//
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──
    function signedIn() {
      return request.auth != null;
    }

    function organizerOf(eventId) {
      return signedIn() &&
        get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid;
    }

    function isEventDoc(eventId) {
      return request.resource.data.eventId == eventId;
    }

    // ── Events ──
    match /events/{eventId} {
      // Anyone with the event code / link can view the event
      allow read: if true;

      // Only signed-in users can create events, and they must own the doc
      allow create: if signedIn()
        && isEventDoc(eventId)
        && request.resource.data.organizerId == request.auth.uid;

      // Only the organizer can edit or delete their event
      allow update, delete: if organizerOf(eventId);
    }

    // ── Photos (sub-collection) ──
    match /events/{eventId}/photos/{photoId} {
      // Public gallery
      allow read: if true;

      // Guests can upload without logging in. Validate the payload shape:
      //  - uploadedAt must be a server timestamp
      //  - cloudinaryUrl must be a Cloudinary HTTPS URL
      allow create: if request.resource.data.cloudinaryUrl is string
        && request.resource.data.cloudinaryUrl.matches('https://res\\.cloudinary\\.com/.*')
        && request.resource.data.uploadedAt is timestamp;

      // Only the organizer can modify or delete photos
      allow update, delete: if organizerOf(eventId);
    }
  }
}
